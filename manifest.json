{
	"manifest_version": 3,
	"name": "CsTraders - Steam Sync",
	"version": "1.0.0",
	"description": "Mantém o histórico de trades da sua conta Steam sincronizado com o CsTraders.",
	"key": "",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"permissions": [
		"storage",
		"alarms"
	],
	"host_permissions": [
		"https://steamcommunity.com/*",
		"https://api.steampowered.com/*",
		"http://localhost/*",
		"https://cstraders.com.br/*"
	],
	"externally_connectable": {
		"matches": [
			"http://localhost/*",
			"https://cstraders.com.br/*"
		]
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_title": "CsTraders - Steam Sync",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	}
}
